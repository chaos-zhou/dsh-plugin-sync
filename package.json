{
  "name": "dsh-plugin-sync",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "跨设备同步 DSH 会话、附件与工作区索引：局域网点对点，或经一个 hub 服务器中转。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sync",
    "multi-device",
    "lan",
    "cordis"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "hub.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
